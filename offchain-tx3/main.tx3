party User;
party Contributor;
party Admin;
party GitHoneyAddr;
party Maintainer;

policy GitHoney = 0x0;

type GithoneyContractRedeemers {
    AddRewards,
    Assign,
    Merge,
    Close,
    Claim,
}

type SettingsRedeemers {
  UpdateSettings,
  CloseSettings,
}

type SettingsDatum {
  githoney_address: Address,
  bounty_creation_fee: Int,
  bounty_reward_fee: Int,
}

type Option {
    Some {
        address: Address,
    },
    None,
}


// REVIEW
type ValuePair {
    key: Bytes,
    value: Int,
}

// REVIEW
type Pairs {
    key: Bytes,
    value: ValuePair,
}


type GithoneyDatum {
  admin_payment_credential: Bytes,
  maintainer_address: Address,
  contributor_address: Option,
//  contributor_address: Option<Address>,
  bounty_reward_fee: Int,
  deadline: Int,
  merged: Bool,
  initial_value: Pairs,
//   initial_value: Pairs<PolicyId, Pairs<AssetName, Int>>,
}


tx createBounty(
    settingsUtxo: UtxoRef, // FIXME: should be a Utxo
    maintainerAddr: Bytes,
    adminAddr: Bytes,
    rewards: List<AnyAsset>,
    deadline: Int,
    bounty_id: Bytes,
    mintingPolicyid: Bytes,
) {

    input maintainer_input {
        from: Maintainer,
        min_amount: Ada(10000000),  // + AnyAsset(),
    }

    mint {
        amount: AnyAsset(mintingPolicyid, bounty_id, 1),
        redeemer: (),
    }

    output bounty_utxo {
        to: GitHoney,
        amount: Ada(5000000) + AnyAsset(mintingPolicyid, bounty_id, 1) + rewards,
        datum: GithoneyDatum {
            admin_payment_credential: adminAddr,
            maintainer_address: maintainerAddr,
            contributor_address: Option, // None
            bounty_reward_fee: 1, // settings.bountyRewardFee,
            deadline: deadline,
            merged: false,
            // initial_value: // TODO,
        },

    }

    output githoney_wallet{
        to: GitHoneyAddr,
        amount: fees,
    }

    output maintainer_output {
        to: Maintainer,
        amount: maintainer_input - fees - Ada(5000000), // - AnyAsset(),
    }

    validity {
        until_slot: deadline,
        since_slot: 1751306068,
    }
}
