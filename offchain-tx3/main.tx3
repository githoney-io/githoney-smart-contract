party User;
party Contributor;
party Admin;
party GitHoneyAddr;
party Maintainer;

policy GitHoney = 0xf8f51d21a8815a7ea5d463d23daf3c0aa11369685dede63fb4a50b3b; // Deployed validator script

type GithoneyContractRedeemers {
    AddRewards,
    Assign,
    Merge,
    Close,
    Claim,
}

type SettingsRedeemers {
    UpdateSettings,
    CloseSettings,
}

type SettingsDatum {
    githoney_address: Address,
    bounty_creation_fee: Int,
    bounty_reward_fee: Int,
}

type Option {
    Some {
        address: Address,
    },
    None,
}

type GithoneyDatum {
    admin_payment_credential: Bytes,
    maintainer_address: Address,
    contributor_address: Option,
    bounty_reward_fee: Int,
    deadline: Int,
    merged: Bool,
//   initial_value: Pairs<PolicyId, Pairs<AssetName, Int>>,
}
