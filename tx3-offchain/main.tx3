party User;
party Contributor;
party Admin;
party GitHoneyAddr;
party Maintainer;
party Script;

type Credentials {
    payment_credential: Bytes,
    staking_credential: Bytes,
}

type GithoneyContractRedeemers {
    AddRewards,
    Assign,
    Merge,
    Close,
    Claim,
}

type SettingsRedeemers {
    UpdateSettings,
    CloseSettings,
}

type SettingsDatum {
    githoney_address: Credentials,
    bounty_creation_fee: Int,
    bounty_reward_fee: Int,
}

type Option {
    Some {
        address: Credentials,
    },
    None,
}

type GithoneyDatum {
    admin_payment_credential: Bytes,
    maintainer_address: Address,
    contributor_address: Option,
    bounty_reward_fee: Int,
    deadline: Int,
    merged: Bool,
//   initial_value: Pairs<PolicyId, Pairs<AssetName, Int>>,
}

// REVIEW

tx createBounty(
    settingsRef: UtxoRef,
    maintainerAddr: Bytes,
    adminAddr: Bytes,
    rewards: List<AnyAsset>,
    since: Int,
    until: Int,
    bountyId: Bytes,
    mintingPolicyId: Bytes,
    collateralRef: UtxoRef,
    // Since the settingsutxo datum cannot be accessed,
    // they are passed as parameters.
    githoneyAddress: Address,
    bountyRewardFee: Int,
    bountyCreationFee: Int,
) {
    reference contract {
        ref: settingsRef,
    }

    input maintainer_input {
        from: Maintainer,
        min_amount: Ada(10000000),  // + AnyAsset(),
    }

    mint {
        amount: AnyAsset(mintingPolicyId, bountyId, 1),
        redeemer: (),
    }

    output bounty_utxo {
        to: GitHoney,
        amount: Ada(5000000) + AnyAsset(mintingPolicyId, bountyId, 1) + rewards,
        datum: GithoneyDatum {
            admin_payment_credential: adminAddr,
            maintainer_address: maintainerAddr,
            contributor_address: Option::None {},
            bounty_reward_fee: bountyRewardFee,
            deadline: until,
            merged: false,
            // initial_value: // TODO,
        },

    }

    output githoney_wallet{
        to: GitHoneyAddr,
        amount: bountyCreationFee,
    }

    output maintainer_output {
        to: Maintainer,
        amount: maintainer_input - bountyCreationFee - fees, // - AnyAsset(),
    }

    validity {
        until_slot: until,
        since_slot: since,
    }
}
