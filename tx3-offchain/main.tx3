party User;
party Contributor;
party Admin;
party GitHoneyAddr;
party Maintainer;
party Script;

type Credentials {
    payment_credential: Bytes,
    staking_credential: Bytes,
}

type GithoneyContractRedeemers {
    AddRewards,
    Assign,
    Merge,
    Close,
    Claim,
}

type SettingsRedeemers {
    UpdateSettings,
    CloseSettings,
}

type SettingsDatum {
    githoney_address: Credentials,
    bounty_creation_fee: Int,
    bounty_reward_fee: Int,
}

type Option {
    Some {
        address: Credentials,
    },
    None,
}

type GithoneyDatum {
    admin_payment_credential: Bytes,
    maintainer_address: Credentials,
    contributor_address: Option,
    bounty_reward_fee: Int,
    deadline: Int,
    merged: Bool,
    initial_value: List<Tuple<Bytes, List<Tuple<Bytes, Int>>>>,
}


tx create(
    settingsRef: UtxoRef,
    maintainerPaymentCredential: Bytes,
    maintainerStakeCredential: Bytes,
    adminAddr: Bytes,
    //NOTE - Since you cannot iterate over lists, we use a fixed asset.
    rewardPolicyId: Bytes,
    rewardAssetName: Bytes,
    rewardAmount: Int,
    since: Int,
    until: Int,
    bountyId: Bytes,
    mintingPolicyId: Bytes,
    collateralRef: UtxoRef,
    minAda: Int,
    // Since the settingsutxo datum cannot be accessed,
    // they are passed as parameters.
    bountyRewardFee: Int,
    bountyCreationFee: Int,

) {
    reference contract {
        ref: settingsRef,
    }

    collateral {
        ref: collateralRef,
    }

    input maintainer_input {
        from: Maintainer,
        min_amount: Ada(10000000) + AnyAsset(rewardPolicyId, rewardAssetName, rewardAmount),
    }

    mint {
        amount: AnyAsset(mintingPolicyId, bountyId, 1),
        redeemer: (),
    }

    output bounty_utxo {
        to: Script,
        amount: Ada(minAda) + AnyAsset(mintingPolicyId, bountyId, 1) + AnyAsset(rewardPolicyId, rewardAssetName, rewardAmount),
        datum: GithoneyDatum {
            admin_payment_credential: adminAddr,
            maintainer_address: Credentials {
                payment_credential: maintainerPaymentCredential,
                staking_credential: maintainerStakeCredential,
            },
            contributor_address: Option::None {},
            bounty_reward_fee: bountyRewardFee,
            deadline: until,
            merged: false,
            initial_value: [
                (
                    rewardPolicyId,
                    [
                        (
                            rewardAssetName,
                            rewardAmount
                        )
                    ]
                )
            ],
        },

    }

    output githoney_wallet{
        to: GitHoneyAddr,
        amount: Ada(bountyCreationFee),
    }

    output maintainer_output {
        to: Maintainer,
        amount: maintainer_input - Ada(bountyCreationFee) - fees - AnyAsset(rewardPolicyId, rewardAssetName, rewardAmount) - Ada(minAda),
    }

    validity {
        until_slot: until,
        since_slot: since,
    }
}
