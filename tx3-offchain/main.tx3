party User;
party Contributor;
party Admin;
party GitHoneyAddr;
party Maintainer;
party Script;

type Credentials {
    payment_credential: Bytes,
    staking_credential: Bytes,
}

type GithoneyContractRedeemers {
    AddRewards,
    Assign,
    Merge,
    Close,
    Claim,
}

type SettingsRedeemers {
    UpdateSettings,
    CloseSettings,
}

type SettingsDatum {
    githoney_address: Credentials,
    bounty_creation_fee: Int,
    bounty_reward_fee: Int,
}

type Option {
    Some {
        address: Credentials,
    },
    None,
}

type GithoneyDatum {
    admin_payment_credential: Bytes,
    maintainer_address: Credentials,
    contributor_address: Option,
    bounty_reward_fee: Int,
    deadline: Int,
    merged: Bool,
//   initial_value: Pairs<PolicyId, Pairs<AssetName, Int>>,
}

tx deploy(
    githoneyAddress: Credentials,
    bountyCreationFee: Int,
    bountyRewardFee: Int,
    settingsPolicyId: Bytes,
    settingsTokenName: Bytes,
    collateralRef: UtxoRef,
) {

    input githoney_wallet {
        from: GitHoneyAddr,
        min_amount: Ada(20000000),
    }

    collateral {
        ref: collateralRef,
    }

    mint {
        amount: AnyAsset(settingsPolicyId, settingsTokenName, 1),
        redeemer: (),
    }

    output change {
        to: GitHoneyAddr,
        amount: githoney_wallet - fees,
    }

    output settings_utxo {
        to: Script,
        amount: fees + AnyAsset(settingsPolicyId, settingsTokenName, 1),
        datum: SettingsDatum {
            githoney_address: githoneyAddress,
            bounty_creation_fee: bountyCreationFee,
            bounty_reward_fee: bountyRewardFee,
        },
    }
}
